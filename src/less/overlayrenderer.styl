@import 'streamoverlay.styl';

// /stream-only positioning: keep the overlay tree past Foundry's chat sidebar.
// Scoped to body.stream so it doesn't apply in the editor canvas pane or the
// Full Preview window, both of which also wear .overlay-renderer for CSS
// injection scoping.
body.stream .overlay-renderer {
  left: 320px;
  position: absolute;
}

.obs-utils.overlay {
  .multi-image-component {
    display: flex;
    flex-direction: row;
  }
}
